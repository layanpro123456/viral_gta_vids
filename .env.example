# ViceClip Archiver Environment Configuration
# Copy this file to .env and populate with your credentials if using authenticated APIs

# YouTube Data API v3 key (optional for basic features, required for YouTubeAdapter)
YOUTUBE_API_KEY=

# Reddit API credentials (optional for public json feeds, required for OAuth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ViceClipArchiver/0.1.0

# Facebook Graph API access token (optional; direct URL download & ingest works without token)
FACEBOOK_ACCESS_TOKEN=

# Database path override (optional)
VICECLIP_DB_PATH=./viceclip.db
